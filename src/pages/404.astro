---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
---

<BaseLayout title={`Page not found — ${SITE_NAME}`} description="The page you requested could not be found.">
  <article class="content-page content-page--centered">
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or may have moved.</p>
    <p>
      <a href="/">Go to Home</a> to search the Directory.
    </p>
  </article>
</BaseLayout>
