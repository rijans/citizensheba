---
import BaseLayout from '../components/layout/BaseLayout.astro';
import {
  NOT_FOUND_DESCRIPTION_BN,
  NOT_FOUND_DESCRIPTION_EN,
  NOT_FOUND_TITLE_BN,
  NOT_FOUND_TITLE_EN,
} from '../lib/site';
import { documentTitle, metaDescription } from '../lib/seo';
---

<BaseLayout
  title={documentTitle(NOT_FOUND_TITLE_BN, NOT_FOUND_TITLE_EN)}
  description={metaDescription(NOT_FOUND_DESCRIPTION_BN, NOT_FOUND_DESCRIPTION_EN)}
>
  <article class="content-page content-page--centered">
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or may have moved.</p>
    <p>
      <a href="/">Go to Home</a> to search the Directory.
    </p>
  </article>
</BaseLayout>
