---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import OutboundCta from '../../components/service/OutboundCta.astro';
import HopDisclose from '../../components/service/HopDisclose.astro';
import BilingualPanes from '../../components/service/BilingualPanes.astro';
import ServiceFaq from '../../components/service/ServiceFaq.astro';
import StatusBadge from '../../components/service/StatusBadge.astro';
import CategoryIcon from '../../components/ui/CategoryIcon';
import ServiceCardLink from '../../components/ui/ServiceCardLink.astro';
import { categoryPath, servicePath } from '../../lib/urls';
// import { REPORT_EMAIL } from '../../lib/site';
import { documentTitle, metaDescription, breadcrumbListJsonLd, webPageJsonLd } from '../../lib/seo';
import { renderMarkdown } from '../../lib/markdown';
import { servicePageHeadings } from '../../lib/servicePageCopy';
import { accentStyleAttr } from '../../lib/categoryVisuals';
import {
  officialDomain,
  relatedIdsFor,
  toDirectoryCard,
  type CategoryProjectionInput,
  type ServiceProjectionInput,
} from '../../lib/serviceProjection';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.data.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const categories = await getCollection('categories');
const category = categories.find((c) => c.data.id === service.data.category);
if (!category) throw new Error('missing category');

const all = await getCollection('services');
const allData: ServiceProjectionInput[] = all.map((s) => s.data);
const catById: Record<string, CategoryProjectionInput> = Object.fromEntries(
  categories.map((c) => [
    c.data.id,
    { id: c.data.id, name: c.data.name, name_bn: c.data.name_bn, icon: c.data.icon },
  ]),
);
const relatedIds = relatedIdsFor(service.data, allData);
const relatedCards = relatedIds.flatMap((id) => {
  const r = all.find((s) => s.data.id === id);
  if (!r) return [];
  const relCat = catById[r.data.category];
  if (!relCat) throw new Error(`missing category for ${r.data.id}`);
  return [toDirectoryCard(r.data, relCat)];
});

const domain = officialDomain(service.data);
const hopIcon = service.data.icon ?? category.data.icon;
const hopAccentAttr = accentStyleAttr(category.data.id);
const title = documentTitle(
  service.data.serp_title_bn ?? service.data.title_bn,
  service.data.serp_title ?? service.data.title,
);
const description = metaDescription(service.data.description_bn, service.data.description);
const canonicalPath = servicePath(service.data.slug);
const jsonLd = [
  breadcrumbListJsonLd([
    { name: category.data.name, path: categoryPath(category.data.slug) },
    { name: service.data.title },
  ]),
  webPageJsonLd({
    name: title,
    description,
    path: canonicalPath,
    dateModified: service.data.last_verified.toISOString().slice(0, 10),
  }),
];
// Temporarily disabled — Report a problem mailto
// const reportSubject = encodeURIComponent(`Report: ${service.data.slug}`);
const formerAliases = (service.data.aliases ?? []).filter((a) => a.kind === 'former');
const bodyHtml = renderMarkdown(service.data.body);
const bodyBnHtml = renderMarkdown(service.data.body_bn);
const verifiedLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(service.data.last_verified);
const verifiedIso = service.data.last_verified.toISOString().slice(0, 10);
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <article class="service-page">
    <Breadcrumb
      crumbs={[
        { label: category.data.name, href: categoryPath(category.data.slug) },
        { label: service.data.title },
      ]}
    />

    <header class="service-page__header">
      <StatusBadge status={service.data.status} />
      <div class="service-page__title-row" style={hopAccentAttr}>
        <CategoryIcon
          icon={hopIcon}
          categoryId={category.data.id}
          inheritAccent
          size={28}
          className="service-page__icon"
        />
        <h1>
          {service.data.title} <span lang="bn">{service.data.title_bn}</span>
        </h1>
      </div>
      {
        formerAliases.length > 0 && (
          <p class="service-page__formerly">
            Formerly{' '}
            {formerAliases.map((a, i) => (
              <span>
                {i > 0 ? ', ' : ''}
                {a.lang === 'bn' ? <span lang="bn">{a.name}</span> : a.name}
              </span>
            ))}
          </p>
        )
      }
    </header>

    <p class="service-page__description">{service.data.description}</p>

    {
      service.data.capabilities && service.data.capabilities.length > 0 && (
        <ul class="service-page__capabilities" aria-label="What you can do">
          {service.data.capabilities.map((cap) => (
            <li class="service-page__capability">
              <span class="service-page__capability-en">{cap.en}</span>
              <span class="service-page__capability-bn" lang="bn">
                {cap.bn}
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <OutboundCta
      url={service.data.url}
      domain={domain}
      verifiedLabel={verifiedLabel}
      verifiedIso={verifiedIso}
    />

    {
      service.data.status !== 'ACTIVE' && (
        <p class="caution">
          The official site may be unavailable or changing. Verify on the government domain above.
        </p>
      )
    }

    <HopDisclose
      variant="primary"
      headingId="service-about-heading"
      headingEn={servicePageHeadings.about.en}
      headingBn={servicePageHeadings.about.bn}
    >
      <BilingualPanes>
        <div slot="bn" class="service-page__prose" lang="bn" set:html={bodyBnHtml} />
        <div slot="en" class="service-page__prose" set:html={bodyHtml} />
      </BilingualPanes>
    </HopDisclose>

    <HopDisclose
      variant="support"
      headingId="service-audience-heading"
      headingEn={servicePageHeadings.audience.en}
      headingBn={servicePageHeadings.audience.bn}
    >
      <BilingualPanes>
        <p slot="bn" lang="bn">
          {service.data.audience_bn}
        </p>
        <p slot="en">{service.data.audience}</p>
      </BilingualPanes>
    </HopDisclose>

    <ServiceFaq items={service.data.faq} />

    <section class="content-section">
      <h2>
        {servicePageHeadings.related.en}{' '}
        <span lang="bn">{servicePageHeadings.related.bn}</span>
      </h2>
      <div class="directory-grid">
        {
          relatedCards.map((card) => (
            <ServiceCardLink
              href={servicePath(card.slug)}
              title={card.title}
              titleBn={card.titleBn}
              description={card.description}
              domain={card.domain}
              status={card.status}
              categoryId={card.categoryId}
              icon={card.icon}
            />
          ))
        }
      </div>
    </section>

    {/* Temporarily disabled — Report a problem
    <p class="service-page__report">
      <a href={`mailto:${REPORT_EMAIL}?subject=${reportSubject}`}>Report a problem</a>
    </p>
    */}
  </article>
</BaseLayout>
