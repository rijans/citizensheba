---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import CategoryDirectory from '../../components/directory/CategoryDirectory';
import { categoryPath, officialDomainFromUrl } from '../../lib/urls';
import { documentTitle, metaDescription } from '../../lib/seo';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((c) => ({ params: { slug: c.data.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const services = (await getCollection('services'))
  .filter((s) => s.data.category === category.data.id)
  .sort((a, b) => {
    if (a.data.directory_category_rank !== b.data.directory_category_rank) {
      return a.data.directory_category_rank - b.data.directory_category_rank;
    }
    return a.data.title.localeCompare(b.data.title);
  })
  .map((s) => ({
    id: s.data.id,
    slug: s.data.slug,
    title: s.data.title,
    titleBn: s.data.title_bn,
    description: s.data.description,
    domain: s.data.official_domain ?? officialDomainFromUrl(s.data.url),
    status: s.data.status,
    directoryCategoryRank: s.data.directory_category_rank,
    ...(s.data.icon ? { icon: s.data.icon } : {}),
  }));

const title = documentTitle(category.data.name_bn, category.data.name);
const description = metaDescription(category.data.description_bn, category.data.description);
---

<BaseLayout title={title} description={description} canonicalPath={categoryPath(category.data.slug)}>
  <article class="category-page">
    <Breadcrumb crumbs={[{ label: category.data.name }]} />

    <header class="category-page__header">
      <h1>
        {category.data.name} <span lang="bn">{category.data.name_bn}</span>
      </h1>
      <p>{category.data.description}</p>
    </header>

    <p class="category-page__browse">
      <a href={`/?cat=${category.data.id}`}>Browse on Home</a>
    </p>

    <CategoryDirectory
      client:idle
      categoryId={category.data.id}
      categoryName={category.data.name}
      icon={category.data.icon}
      services={services}
    />
  </article>
</BaseLayout>
