---
import HopDisclose from './HopDisclose.astro';
import BilingualPanes from './BilingualPanes.astro';
import { servicePageHeadings } from '../../lib/servicePageCopy';

interface FaqItem {
  q: string;
  a: string;
  q_bn: string;
  a_bn: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
const { faq: heading } = servicePageHeadings;
---

<HopDisclose
  variant="support"
  headingId="service-faq-heading"
  headingEn={heading.en}
  headingBn={heading.bn}
  class="service-faq"
>
  {
    items.map((item) => (
      <div class="service-faq__item">
        <h3>
          {item.q} <span lang="bn">{item.q_bn}</span>
        </h3>
        <BilingualPanes>
          <p slot="bn" lang="bn">
            {item.a_bn}
          </p>
          <p slot="en">{item.a}</p>
        </BilingualPanes>
      </div>
    ))
  }
</HopDisclose>
