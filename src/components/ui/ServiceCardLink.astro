---
import CategoryIcon from './CategoryIcon';
import StatusBadge from '../service/StatusBadge.astro';
import { accentStyle } from '../../lib/categoryVisuals';

interface Props {
  href: string;
  title: string;
  titleBn: string;
  description: string;
  domain: string;
  status: 'ACTIVE' | 'MAINTENANCE' | 'DEPRECATED';
  categoryId: string;
  icon: string;
}

const { href, title, titleBn, description, domain, status, categoryId, icon } = Astro.props;
const style = accentStyle(categoryId);
const styleAttr = Object.entries(style)
  .map(([k, v]) => `${k}:${v}`)
  .join(';');
---

<a class="service-card" href={href} style={styleAttr}>
  <div class="service-card__top">
    <CategoryIcon icon={icon} categoryId={categoryId} inheritAccent size={20} />
    <div class="service-card__titles">
      <h3 class="service-card__title">{title}</h3>
      <p class="service-card__title-bn" lang="bn">{titleBn}</p>
    </div>
    <StatusBadge status={status} />
  </div>
  <p class="service-card__description">{description}</p>
  <p class="service-card__domain">{domain}</p>
</a>
